# Server Environment Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@tridentsecuritys.com
ADMIN_DEFAULT_PASSWORD=ChangeThisPasswordInProd123!
DATA_ENCRYPTION_KEY=your_32_byte_aes_key_or_leave_empty_for_hash

# MySQL Database Configuration (Optional - Memory storage used if DB unavailable)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trident_security_db
DB_CONNECTION_LIMIT=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000
